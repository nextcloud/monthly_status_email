{
  "name": "monthly_status_email",
  "description": "This application enable to send monthly summary to users about their disk usage.",
  "author": "Carl Schwan <carl@carlschwan.eu>",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "repository": {
    "url": "https://github.com/nextcloud/monthly_status_email",
    "type": "git"
  },
  "scripts": {
    "build": "vite build --mode production",
    "dev": "vite build --mode development",
    "watch": "vite build --watch",
    "lint": "vue-tsc --noEmit && eslint --ext .js,.vue,.ts,.mjs src playwright --max-warnings=0",
    "lint:fix": "vue-tsc --noEmit && eslint --ext .js,.vue,.ts,.mjs src playwright --fix",
    "stylelint": "stylelint 'src/**/*.vue'",
    "stylelint:fix": "stylelint 'src/**/*.vue' --fix",
    "start:nextcloud": "node playwright/start-nextcloud-server.js"
  },
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.3.0"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@nextcloud/axios": "^2.5.1",
    "@nextcloud/e2e-test-server": "^0.5.0",
    "@nextcloud/initial-state": "^3.0.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/logger": "^3.0.3",
    "@nextcloud/paths": "^3.1.0",
    "@nextcloud/router": "^3.0.1",
    "@nextcloud/vue": "^9.9.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@nextcloud/browserslist-config": "^3.0.1",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/eslint-plugin": "^2.2.1",
    "@nextcloud/stylelint-config": "^3.2.2",
    "@nextcloud/vite-config": "^2.5.4",
    "@playwright/test": "^1.62.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.6.0",
    "vite": "^7.3.6",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vue-tsc": "^3.3.8"
  }
}
